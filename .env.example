# Mẫu biến môi trường cho Docker Compose.
# Chép thành file .env (không commit .env) rồi điền giá trị thật.
# Mật khẩu chỉ dùng chữ cái và chữ số (để ghép được vào DATABASE_URL).

# Tài khoản trang admin (mật khẩu tối thiểu 12 ký tự)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# PostgreSQL
POSTGRES_USER=daptoi
POSTGRES_PASSWORD=
POSTGRES_DB=daptoi

# Đặt 1 khi chạy sau reverse proxy (Caddy) để lấy IP thật và nhận biết HTTPS
TRUST_PROXY=0

# Cổng mở trên máy (mặc định 3000; compose.prod.yaml không mở cổng này)
APP_PORT=3000

# Chỉ dùng với compose.prod.yaml: tên miền Caddy lấy chứng chỉ HTTPS
# (thử trên máy cá nhân: SITE_DOMAIN=localhost)
SITE_DOMAIN=fptelecom.io.vn
